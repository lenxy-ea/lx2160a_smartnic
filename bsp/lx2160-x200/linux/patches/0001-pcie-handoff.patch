+/* X200 diagnostic ownership: host removes both bootstrap PFs before boot.
+ * CFG_READY is withdrawn during register replacement, then published only
+ * after configfs has bound the real function. No hot-reset recovery contract.
+ * EPF polling starts at bind (no link notifications) and synchronous unlink
+ * drains it. Stop withdraws host visibility; it does not free the function.
+ */
+static void x200_ep_set_ready(struct ls_pcie_ep *pcie, bool ready)
+{
+	u32 cfg = ls_pcie_pf_lut_readl(pcie, PEX_PF0_CONFIG);
+
+	if (ready)
+		cfg |= PEX_PF0_CFG_READY;
+	else
+		cfg &= ~PEX_PF0_CFG_READY;
+	ls_pcie_pf_lut_writel(pcie, PEX_PF0_CONFIG, cfg);
+}
+
+static int x200_ep_start(struct dw_pcie *pci)
+{
+	x200_ep_set_ready(to_ls_pcie_ep(pci), true);
+	return 0;
+}
+
+static void x200_ep_stop(struct dw_pcie *pci)
+{
+	x200_ep_set_ready(to_ls_pcie_ep(pci), false);
+}
+
+static const struct dw_pcie_ops x200_ep_dw_ops = {
+	.start_link = x200_ep_start,
+	.stop_link = x200_ep_stop,
+};
 
