+/* Read-only diagnostic snapshots. epf->lock excludes bind/unbind so BAR
+ * backing remains allocated while read. Counters have one writer (the poller);
+ * individual fields are sampled with READ_ONCE, not as an atomic snapshot.
+ */
+static ssize_t epf_ntb_diagnostics_show(struct config_item *item, char *page)
+{
+	struct epf_ntb *ntb = to_epf_ntb(to_config_group(item));
+	struct pci_epf *epf = ntb->epf;
+	ssize_t len;
+
+	mutex_lock(&epf->lock);
+	if (READ_ONCE(ntb->stopping)) {
+		len = sysfs_emit(page, "bound=0\n");
+		goto out;
+	}
+	len = sysfs_emit(page,
+		"bound=1 poll_count=%llu db_observed=%llu db_events=%llu "
+		"db=%#lx db_mask=%#lx "
+		"epf_db0=%#x epf_db1=%#x epf_db2=%#x epf_db3=%#x "
+		"config_phys=%pa doorbell_phys=%pa mw_phys=%pa\n",
+		READ_ONCE(ntb->poll_count), READ_ONCE(ntb->db_observed),
+		READ_ONCE(ntb->db_events), READ_ONCE(ntb->db),
+		READ_ONCE(ntb->db_mask), READ_ONCE(ntb->epf_db[0]),
+		READ_ONCE(ntb->epf_db[1]), READ_ONCE(ntb->epf_db[2]),
+		READ_ONCE(ntb->epf_db[3]),
+		&epf->bar[ntb->epf_ntb_bar[BAR_CONFIG]].phys_addr,
+		&epf->bar[ntb->epf_ntb_bar[BAR_DB]].phys_addr,
+		&epf->bar[ntb->epf_ntb_bar[BAR_MW0]].phys_addr);
+out:
+	mutex_unlock(&epf->lock);
+	return len;
+}
